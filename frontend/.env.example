# Copier en .env.local pour le développement local (npm run dev)

# true  = le front fonctionne seul avec une fausse API en mémoire (mock) — parfait pour travailler sans backend
# false = le front appelle le vrai backend FastAPI
VITE_USE_MOCK=true

# URL de base de l'API vue par le navigateur. /api = relayé par Vite (dev) ou nginx (Docker).
# VITE_API_URL=/api

# Cible du relais Vite en dev (backend lancé hors Docker : http://localhost:8000)
# VITE_PROXY_TARGET=http://localhost:8000

# Affiche les comptes de test sur l'écran de connexion (mock uniquement). Toujours actif avec npm run dev.
# VITE_SHOW_DEMO_ACCOUNTS=true
