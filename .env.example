# Copie ce fichier en ".env" (ou lance setup.ps1 / setup.sh qui le fait avec des secrets aléatoires).
# Le fichier .env ne doit JAMAIS être commité (il est dans .gitignore).

POSTGRES_ADMIN_PASSWORD=CHANGE_ME
ASTRO_LOGIN_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_LONG_RANDOM
# Code d'accès de démonstration affiché au jury (n° d'astronaute : 1)
DEMO_PASSCODE=CHANGE_ME
